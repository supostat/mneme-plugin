{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/launch.sh --warm",
            "timeout": 120,
            "statusMessage": "Warming the mneme engine cache"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/design-lint.mjs --hook",
            "timeout": 5,
            "statusMessage": "design-lint: checking the edited design file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/scripts/design-lint.mjs --hook",
            "timeout": 15,
            "statusMessage": "design-lint: sweeping design/ for drift"
          }
        ]
      }
    ]
  }
}
